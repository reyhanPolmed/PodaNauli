# Akun stakeholder admin. Ganti password sebelum menjalankan API.
PODANAULI_ADMIN_USERNAME=stakeholder
PODANAULI_ADMIN_PASSWORD=ganti_dengan_password_kuat_minimal_12_karakter

# Gunakan true saat website dilayani melalui HTTPS.
PODANAULI_COOKIE_SECURE=false
PODANAULI_SESSION_HOURS=8

# Opsional. Default-nya frontend/dist di dalam repository.
# PODANAULI_FRONTEND_DIST=/workspace/PodaNauli/frontend/dist

# Isi dengan origin frontend ketika API dan frontend di-deploy pada domain berbeda.
PODANAULI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
